{{ 'splide.min.css' | asset_url | stylesheet_tag }}
{{ 'tnt-blogs.css' | asset_url | stylesheet_tag }}
{{ 'tnt-recommended-blogs.css' | asset_url | stylesheet_tag }}

<div class="tnt-blog-section">
  <div class="page-width">  
    <div class="tnt-blog-wrap">
      {% if section.settings.heading != blank %}
        <h3>{{ section.settings.heading }}</h3>
      {% endif %}

      {% assign blog_handle = section.settings.blog %}
      {% assign blog = blogs[blog_handle] %}

      {% if blog.articles.size > 0 %}
        <div class="splide tnt-blog-splide" role="group" aria-label="Recommended Blogs">
          <div class="splide__track">
            <ul class="splide__list">
              {% for article in blog.articles limit: section.settings.post_limit %}
                <li class="splide__slide">
                  {% render 'tnt-blog-card',
                    image: article.image,
                    excerpt: article.excerpt,
                    content: article.content,
                    title: article.title,
                    url: article.url
                  %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% else %}
        <p>No blog posts found.</p>
      {% endif %}
    </div>
  </div>
</div>

{{ 'splide.min.js' | asset_url | script_tag }}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Splide('.tnt-blog-splide', {
      type   : 'loop',
      perPage: 3,
      arrows: false,
      gap    : '24px',
      breakpoints: {
        1024: {
          perPage: 2,
        },
        640: {
          perPage: 1,
        }
      }
    }).mount();
  });
</script>


{% schema %}
{
  "name": "<> Recommended Blogs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title Here",
      "default": "You May Also Like"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of Posts to Show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "<> Recommended Blogs",
      "category": "Blog"
    }
  ]
}
{% endschema %}
