{{ 'tnt-blogs.css' | asset_url | stylesheet_tag }}

<div class="tnt-blog-section">
  <div class="page-width">  
    <div class="tnt-blog-container">
      {% if blog.articles.size > 0 %}
        {%- paginate blog.articles by section.settings.post_limit -%}
          {% for article in blog.articles %}
            {% render 'tnt-blog-card',
              image: article.image,
              excerpt: article.excerpt,
              content: article.content,
              title: article.title,
              url: article.url
            %}

            {% if forloop.index == 6 and section.settings.banner_image != blank %}
              <div class="tnt-banner-wrapper" style="background-image: url({{ section.settings.banner_image | img_url: 'master' }});">
                <div class="tnt-banner-overlay"></div>
                <div class="tnt-banner-content">
                  {% if section.settings.banner_heading != blank %}
                    <h2 class="tnt-banner-heading">{{ section.settings.banner_heading }}</h2>
                  {% endif %}
                  {% if section.settings.banner_text != blank %}
                    <p class="tnt-banner-text">{{ section.settings.banner_text }}</p>
                  {% endif %}
                  {% if section.settings.banner_button_text != blank and section.settings.banner_button_link != blank %}
                    <a href="{{ section.settings.banner_button_link }}" class="tnt-banner-button">
                      {{ section.settings.banner_button_text }}
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}


          <div class="tnt-blog-pagination">
            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          </div>
        {% endpaginate %}
      {% else %}
        <p>No blog posts found.</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "<> Blog Posts",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of Posts to Show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 9
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Richird Norton photorealistic rendering as real photos"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Banner Description",
      "default": "Photorealistic rendering concepts with visionary thinking. The leading product showcase."
    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Banner Button Text",
      "default": "Start planning your trip"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Banner Button Link"
    }
  ],
  "presets": [
    {
      "name": "<> Blog Posts",
      "category": "Blog"
    }
  ]
}
{% endschema %}
