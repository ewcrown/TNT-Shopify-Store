{{ 'section-tnt-footer.css' | asset_url | stylesheet_tag }}

<div class="tnt-footer" id="tnt-footer">
  <div class="tnt-footer__row">
    <div class="tnt-footer__container page-width">
      <div class="tnt-footer__content tnt-flex tnt-align-items-center tnt-justify-content-between">
        <div class="tnt-footer__brand tnt-flex tnt-align-items-center ">
          <div class="tnt-footer__logo">
            {% if section.settings.logo != blank %}
              <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="Footer Logo" loading="lazy">
            {% endif %}
          </div>

          <div class="tnt-footer__menu">
            {%- for block in section.blocks -%}
              {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                <ul class="footer-block__details-content list-unstyled tnt-flex" {{ block.shopify_attributes }}>
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="tnt-footer__bottom">
          <div class="footer__copyright caption">
            <small class="copyright__content">
              &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}.
            </small>
            All rights reserved.
            {% comment %}
              <small class="copyright__content">{{ powered_by_link }}</small>

              {% if section.settings.show_policy and shop.policies.size > 0 %}
                <ul class="policies list-unstyled">
                  {%- for policy in shop.policies -%}
                    {% if policy != blank %}
                      <li>
                        <small class="copyright__content">
                          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                        </small>
                      </li>
                    {% endif %}
                  {%- endfor -%}
                </ul>
              {% endif %}
            {% endcomment %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show store policies",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
    }
  ]
}
{% endschema %}
