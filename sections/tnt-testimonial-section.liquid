<section class="tnt-testimonial-section tnt-testimonial-section-{{ section.id }}" id="tnt-testimonial-section">
  <div class="tnt-testimonial-row">
    <div class="page-width">
      <div class="tnt-testimonial-wrap swiper-container">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="testimonial-slide">
                {% if block.settings.testimonial_text != blank %}
                  <p class="testimonial-text">{{ block.settings.testimonial_text }}</p>
                {% endif %}
                {% if block.settings.author_image != blank %}
                  <div class="testimonial-author-image">
                    <img src="{{ block.settings.author_image | img_url: '100x100' }}" alt="{{ block.settings.author_name }}" />
                  </div>
                {% endif %}
                {% if block.settings.author_name != blank %}
                  <p class="testimonial-author-name">{{ block.settings.author_name }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Optional Swiper navigation -->
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-pagination"></div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.tnt-testimonial-wrap.swiper-container', {
      loop: true,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      slidesPerView: 4,
      spaceBetween: 30,
    });
  });
</script>


{% schema %}
{
  "name": "<> Testimonial",
  "settings": [],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "testimonial_text",
          "label": "Testimonial Text"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Testimonial",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
