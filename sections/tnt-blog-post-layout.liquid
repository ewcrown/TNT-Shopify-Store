{{ 'tnt-blog-post-layout.css' | asset_url | stylesheet_tag }}
{{ 'tnt-latest-blog-card.css' | asset_url | stylesheet_tag }}

<section class="tnt-single-post-section">
  <div class="page-width">
    
    <div class="tnt-single-post-inner"> 
      
      <article class="tnt-single-post-content">
        <div class="tnt-single-post-body">
          {{ article.content }}
        </div>

        <!-- Social Sharing -->
        <div class="tnt-single-post-share">
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" class="tnt-single-post-share-icon tnt-single-post-share-facebook">
