</svg>
          </a>
        </div>

        <!-- View Comments Button -->
        <div class="tnt-single-post-comments-wrapper">
          <a href="#comments" class="tnt-single-post-comments-button">View Comments ({{ article.comments_count }})</a>
        </div>

        <!-- Newsletter Signup -->
   <div class="tnt-single-post-newsletter">
  <h4>SIGN UP FOR OUR NEWSLETTERS</h4>
  <p>GET NOTIFIED OF THE BEST DEALS ON OUR SHOPIFY BLOGS.</p>
  
  <form method="post" action="/contact#ContactFooter">
    <div class="tnt-newsletter-inputs">
      <input type="text" name="contact[firstname]" placeholder="Enter your name" required>
      <input type="email" name="contact[email]" placeholder="Enter your email" required>
      <button type="submit">SUBSCRIBE</button>
    </div>

    <div class="tnt-newsletter-consent">
      <input type="checkbox" id="newsletter-agree" required>
      <label for="newsletter-agree">
        By checking this box, you confirm that you have read and are agreeing to our <a href="/policies/terms-of-service" target="_blank">terms of use</a> regarding the storage of the data submitted through this form.
      </label>
    </div>
  </form>
</div>

      </article>
      
      <div class="tnt-single-post-latest">
        {% assign blog_handle = section.settings.blog %}
        {% assign blog = blogs[blog_handle] %}
        <h3>{{ section.settings.heading }}</h3>
        <div class="tnt-single-post-latest">
        {% for article in blog.articles limit: section.settings.post_limit %}
          {% render 'tnt-latest-blog-card',
            image: article.image,
            title: article.title,
            url: article.url,
            published_at: article.published_at
          %}
        {% endfor %}
        </div>
      </div>
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Blog Layout",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title Here",
      "default": "The Latest"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of Posts to Show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "<> Blog Layout"
    }
  ]
}
{% endschema %}
