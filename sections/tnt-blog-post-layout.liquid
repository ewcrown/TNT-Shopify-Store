</svg>
          </a>
          <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&media={{ article.image | img_url: '800x' }}&description={{ article.title }}" target="_blank" class="tnt-single-post-share-icon tnt-single-post-share-pinterest">
