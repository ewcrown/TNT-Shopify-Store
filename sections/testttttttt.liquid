{{ 'section-tnt-home-block.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-info.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-banner.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-discount.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-collection.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-moment.css' | asset_url | stylesheet_tag }}
{{ 'tnt-block-announcement.css' | asset_url | stylesheet_tag }}

<div class="tnt-home-block" id="tnt-home-block">
  <div class="tnt-home-block__row">
    <div class="page-width">
      <div class="tnt-home-block__col">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
              <!-- banner block 1 -->
            {%- when 'tnt_banner' -%}
              {% render 'tnt-block-banner', block: block %}

              <!-- collection 1 -->
            {%- when 'collection_list' -%}
              {% render 'tnt-block-collection' %}

              <!-- Announcement bar -->
            {%- when 'announcement_bar' -%}
              <div class="tnt-home-block__collection-announcement-bar">
                <!-- block announcement -->
                {% render 'tnt-block-announcement', block: block %}

                <div class="tnt-home-block__title-wrap">
                  <h2 class="tnt-home-block__title">TodsNTeens Picks</h2>
                </div>

                <!-- block announcement -->
                {% render 'tnt-block-announcement', block: block %}

                {% render 'tnt-block-collection', block: block %}
              </div>

              <!-- Discount block 2 -->
            {%- when 'discount' -%}
              {% render 'tnt-block-discount', block: block %}

              <!-- info block -->
            {%- when 'info' -%}
              {% render 'tnt-block-info', block: block %}

              <!-- moment block -->
            {%- when 'moment' -%}
              {% render 'tnt-block-moment', block: block %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

