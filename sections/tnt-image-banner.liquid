{{ 'tnt-image-banner.css' | asset_url | stylesheet_tag }}

<section class="tnt-image-banner tnt-image-banner-{{ section.id }}" id="tnt-image-text-section">
  <div class="tnt-image-banner-row">
    <div class="page-width">
    <div class="tnt-image-banner-col">
      {% if section.settings.mobile_image != blank and section.settings.desktop_image != blank %}
        <a href="{{ section.settings.image_link }}" target="_blank">
          <picture>
            <!-- Mobile image -->
            <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 1600 }}">
            <!-- Desktop image -->
            <source media="(min-width: 768px)" srcset="{{ section.settings.desktop_image | image_url: width: 1600 }}">
            <!-- Required fallback image -->
            <img
              src="{{ section.settings.desktop_image | image_url: width: 1600 }}"
              alt="Banner Image"
              loading="lazy"
            >
          </picture>
        </a>
      {% endif %}
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TNT Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link",
    }
  ],
  "presets": [
    {
      "name": "TNT Image Banner"
    }
  ]
}
{% endschema %}
