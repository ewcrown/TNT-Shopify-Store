<div class="tnt-home-block__info">
  <h2 class="tnt-home-block__info-title tnt-home-block__title">
    {{ block.settings.ttl }}
  </h2>

  <div class="tnt-home-block__info-wrap">
    <div class="tnt-home-block__info-item-list tnt-flex tnt-justify-content-between">
      <div class="tnt-home-block__info-item">
        {% if block.settings.icon_1 != blank %}
          <img
            class="img-responsive tnt-home-block__info-item-icon"
            src="{{ block.settings.icon_1 | image_url: width: 800 }}"
            alt="{{ block.settings.title_1 }}"
          >
        {% endif %}
        <h5 class="tnt-home-block__info-title">{{ block.settings.title_1 }}</h5>
        <p class="tnt-home-block__info-item-text">{{ block.settings.text_1 }}</p>
      </div>

      <div class="tnt-home-block__info-item">
        {% if block.settings.icon_2 != blank %}
          <img
            class="img-responsive tnt-home-block__info-item-icon"
            src="{{ block.settings.icon_2 | image_url: width: 800 }}"
            alt="{{ block.settings.title_2 }}"
          >
        {% endif %}
        <h5 class="tnt-home-block__info-title">{{ block.settings.title_2 }}</h5>
        <p class="tnt-home-block__info-item-text">{{ block.settings.text_2 }}</p>
      </div>

      <div class="tnt-home-block__info-item">
        {% if block.settings.icon_3 != blank %}
          <img
            class="img-responsive tnt-home-block__info-item-icon"
            src="{{ block.settings.icon_3 | image_url: width: 800 }}"
            alt="{{ block.settings.title_3 }}"
          >
        {% endif %}
        <h5 class="tnt-home-block__info-title">{{ block.settings.title_3 }}</h5>
        <p class="tnt-home-block__info-item-text">{{ block.settings.text_3 }}</p>
      </div>
    </div>

    {% if block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="tnt-home-block__info-btn">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>
