<div class="tnt-home-block__banner">
  <h2 class="tnt-home-block__banner-title">{{ block.settings.ttl }}</h2>
  <span class="tnt-home-block__banner-off">{{ block.settings.off_txt }}</span>
  {% if block.settings.img != blank %}
    <a href="{{ block.settings.url }}" class="tnt-home-block__banner-link">
      <img
        class="tnt-home-block__banner-img"
        src="{{ block.settings.img | image_url: width: 800  }}"
        alt=""
      >
    </a>
  {% endif %}
</div>
