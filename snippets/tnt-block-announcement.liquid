<div class="tnt-announcement-bar">
  <div class="tnt-swiper-container">
    <div class="swiper-wrapper">
      {% for i in (1..15) %}
        {% if title != blank %}
          <div class="swiper-slide">{{ title }}</div>
          <div class="swiper-slide">-</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
